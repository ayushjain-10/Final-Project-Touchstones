# Touchstones frontend environment.
# Copy to `.env` and fill in real values. NEVER commit a real .env.

# Base URL of the Touchstones backend API (no trailing slash).
VITE_API_URL=http://localhost:3001
# Production app:
# VITE_API_URL=https://api.touchstones.ai

# Supabase project URL and ANON (publishable) key.
# Use the ANON key ONLY in the frontend — never the service-role key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Gate the real product. PRODUCTION shows the waitlist site ONLY, so leave this
# unset (or anything other than "true"). Set to "true" in local dev / preview to
# enable the /app/*, /candidate, and /login routes.
# VITE_APP_ENABLED=true

# Marketing home: show the product walkthrough assets. OFF by default so the waitlist
# build stays lightweight. Set to "true" in local dev / preview to see it.
# VITE_DEMO_TOUR=true

# Editorial Evidence Ledger redesign for the marketing home and recruiter
# dashboard. OFF by default. Enable only in local development or a dev preview.
# VITE_EDITORIAL_UI_ENABLED=true

# Product analytics. Public client-side API key, but keep real values in local/dev
# env files and deployment env vars. Analytics initialize only after consent.
# VITE_AMPLITUDE_API_KEY=your-amplitude-api-key

# July MVP buildout scaffold. OFF by default; set to "true" only in local/dev preview
# to show /app/mvp-buildout and the sidebar link.
# VITE_MVP_SKELETONS_ENABLED=true

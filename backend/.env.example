# ── Core ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
FRONTEND_URL=https://app.touchstones.ai
# Public API origin used in OpenAPI docs, Verify API audit/report URLs, and
# integrations that need to mint links back to this backend.
API_PUBLIC_URL=https://api.touchstones.ai

# ── Auth / secrets ─────────────────────────────────────────────────────────────
# JWT_SECRET and SUPABASE_SERVICE_ROLE_KEY MUST be >= 32 bytes in production — the
# app refuses to boot otherwise (see src/config/assertEnv.js). No 'dev-secret-key'
# fallback exists anymore. SESSION_SECRET defaults to JWT_SECRET if unset.
JWT_SECRET=change_me_to_a_32_byte_or_longer_random_string
SESSION_SECRET=
# Optional: bypass auth with the mock DB for local dev/tests ONLY (never engages in prod).
USE_MOCK_DB=false

# ── Supabase (the only data layer) ─────────────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
USE_SUPABASE=true
# Set true if pg_cron is enabled in Supabase (disables the Node follow-up scheduler).
USE_PG_CRON=false

# ── AI scoring (Anthropic Claude) ──────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key
AI_LLM_MODEL=claude-haiku-4-5
# Self-consistency grader passes per score (median-aggregated).
AI_SELF_CONSISTENCY_N=3
# Token diet + resilience (SYSTEM_DESIGN #13/#9).
AI_SCORE_MAX_TOKENS=800
AI_SCORE_TIMEOUT_MS=30000
AI_SCORE_MAX_RETRIES=3
# Budget rails (SYSTEM_DESIGN #5). Checked before every model call.
AI_RATE_LIMIT_MAX=30
AI_DAILY_SCORING_QUOTA_PER_ACCOUNT=200
AI_DAILY_GLOBAL_CALL_CEILING=5000
AI_DAILY_GLOBAL_SPEND_CEILING_USD=5
AI_EST_COST_PER_SCORE_USD=0.004
# Async scoring queue + worker (SYSTEM_DESIGN #8). Off => inline scoring (default).
USE_SCORING_QUEUE=false
SCORING_WORKER_INTERVAL_MS=2000
SCORING_JOB_MAX_ATTEMPTS=3

# ── Observability (SYSTEM_DESIGN #15) ──────────────────────────────────────────
# Sentry is optional: leave SENTRY_DSN unset to disable (the code no-ops gracefully).
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
LOG_LEVEL=info

# ── Paid recruiter-side surfaces (ops kill-switches; "false" => 503) ───────────
ENABLE_AUTOPILOT=true
ENABLE_SOURCING=true
# Opt-in active face-liveness (camera, biometric). Default OFF — behavioral-only MVP.
ENABLE_LIVENESS=false

# ── Stripe ─────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=your_stripe_secret_key
# Required: signature-verifies incoming webhooks. If unset, POST /api/webhooks/stripe
# rejects every request — it never processes unsigned/forged events.
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
# Recurring monthly Price IDs for the self-serve tiers. Optional: if unset, the
# checkout route resolves them by lookup_key (touchstones_startup_monthly /
# touchstones_growth_monthly). Create both with: node scripts/setupStripeProducts.js
STRIPE_PRICE_STARTUP=your_startup_price_id
STRIPE_PRICE_GROWTH=your_growth_price_id

# ── Email — Resend (preferred) ─────────────────────────────────────────────────
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=Touchstones <noreply@touchstones.ai>
RESEND_REPLY_TO=help@touchstones.ai
# CAN-SPAM postal footer on every email (emails/render.js + emailCompliance). Set the real
# physical postal address before launch; the code falls back to the address in migrations 081/089.
EMAIL_POSTAL_ADDRESS=TouchstonesAI, Inc. · 2058 Rutherford Lane, Fremont, CA 94539
# SMTP fallback (used only when RESEND_API_KEY is unset). emailService reads EMAIL_PASSWORD.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM_NAME=Touchstones

# ── Google OAuth / Calendar ────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3001/api/integrations/google/callback
# Production:
# GOOGLE_CALLBACK_URL=https://api.touchstones.ai/api/auth/google/callback
# GOOGLE_CALENDAR_REDIRECT_URI=https://api.touchstones.ai/api/integrations/google/callback

# ── Calendly OAuth ─────────────────────────────────────────────────────────────
CALENDLY_CLIENT_ID=your_calendly_client_id
CALENDLY_CLIENT_SECRET=your_calendly_client_secret
CALENDLY_REDIRECT_URI=http://localhost:3001/api/integrations/calendly/callback

# ── Cloudflare Turnstile (anti-bot on register / request-demo / assessment start)
# If unset, server-side verification is skipped (dev-friendly).
TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# ── Misc ───────────────────────────────────────────────────────────────────────
DEMO_REQUEST_INBOX=help@touchstones.ai
# Semantic matching (pgvector). If no key, a deterministic local embedder is used.
VOYAGE_API_KEY=your_voyage_api_key
EMBEDDING_PROVIDER=auto
OPENAI_API_KEY=your_openai_api_key

# ── Score delivery — "lands where you hire" (all optional; graceful no-op if unset) ──
SLACK_WEBHOOK_URL=
ASHBY_API_KEY=
GREENHOUSE_API_KEY=
GREENHOUSE_ON_BEHALF_OF=

# ── Ashby integration (per-tenant outbound key stored encrypted; see ashbyAssessmentService) ──
# ASHBY_API_BASE overrides the Ashby host (default https://api.ashbyhq.com) — dev/sandbox only.
ASHBY_API_BASE=
# ASHBY_ENC_KEY: 32-byte key (64-hex or base64) for AES-256-GCM at rest (cryptoVault). In prod SET
# THIS EXPLICITLY — otherwise cryptoVault derives a key from SUPABASE_SERVICE_ROLE_KEY and rotating
# the service key would orphan every encrypted value. Shared by the Ashby + Greenhouse settings.
ASHBY_ENC_KEY=

# ── Greenhouse Harvest v3 (client-credentials OAuth; note write-back) ──
# OFF by default. When 'true', the delivery push routes greenhouse notes through the v3 path for any
# recruiter who has stored a v3 credential (POST /api/integrations/greenhouse/settings). v1/v2 sunset
# 2026-08-31. The per-tenant client_secret is stored encrypted with the same key as Ashby (ASHBY_ENC_KEY).
GREENHOUSE_V3_ENABLED=false
GREENHOUSE_API_BASE=https://harvest.greenhouse.io/v3
GREENHOUSE_AUTH_URL=https://auth.greenhouse.io/token

# ── Greenhouse Assessments partner integration (Take-Home Test; OFF by default) ──
# Gates the partner-hosted endpoints at /integrations/greenhouse, the completion PATCH, the
# settings surface (assessment key mint + OAuth connect), and the OAuth keep-alive job. Nothing
# may run against real customers until Greenhouse approves the integration.
GREENHOUSE_ASSESSMENTS_ENABLED=false
# Partner OAuth client (issued by Greenhouse Partner Support; testing client works only against
# our own sandbox). The authorize URL rarely changes; the token URL reuses GREENHOUSE_AUTH_URL.
GREENHOUSE_OAUTH_CLIENT_ID=
GREENHOUSE_OAUTH_CLIENT_SECRET=
GREENHOUSE_OAUTH_AUTHORIZE_URL=https://auth.greenhouse.io/authorize
# Space-separated scopes to request on connect (must match what Partner Support granted).
GREENHOUSE_OAUTH_SCOPES=harvest:notes:create harvest:candidates:list harvest:applications:list
# Public origin of THIS backend; the registered redirect URI is
# <BACKEND_PUBLIC_URL>/api/integrations/greenhouse/oauth/callback (falls back to API_PUBLIC_URL).
BACKEND_PUBLIC_URL=
# Keep-alive refresher cadence (rotating refresh tokens die within ~24h of inactivity).
GREENHOUSE_OAUTH_KEEPALIVE_INTERVAL_MS=43200000
# AI assistant + direction-scoring token budgets
AI_ASSIST_MAX_TOKENS=800
AI_DIRECTION_MAX_TOKENS=700

# Stripe Price IDs (from scripts/setupStripeProducts.js; resolves by lookup_key if unset)
STRIPE_PRICE_STARTUP=
STRIPE_PRICE_GROWTH=

# testmail.app — test-only inbox for asserting transactional emails in scripts/smoke-e2e.mjs
# (run with SMOKE_ASSERT_EMAIL=1). Get the key from the testmail.app dashboard; never commit a real value.
TESTMAIL_API_KEY=
TESTMAIL_NAMESPACE=

# ── Azure OpenAI (primary LLM + embeddings) ────────────────────────────────────
# All model calls route through Azure OpenAI. LLM_PROVIDER=azure forces it; otherwise Azure is
# used whenever these are set, falling back to Anthropic only if no Azure config is present.
# Reasoning models (gpt-5*/o-series) use max_completion_tokens + reasoning_effort — the adapter
# in aiService.js handles that automatically. text-embedding-3-large is requested at 1536-d so
# vectors drop into the existing vector(1536) pgvector column with no migration.
LLM_PROVIDER=azure
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_KEY=your_azure_openai_key
AZURE_OPENAI_DEPLOYMENT=gpt-5.4-mini
AZURE_OPENAI_EMBED_DEPLOYMENT=text-embedding-3-large
AZURE_OPENAI_API_VERSION=2025-04-01-preview
AZURE_OPENAI_REASONING_EFFORT=low
AZURE_OPENAI_MAX_COMPLETION_FLOOR=4000
EMBEDDING_PROVIDER=azure

# ── Azure AI Content Safety — Prompt Shields (defense-in-depth on the grader) ───
# An out-of-band ML prompt-injection check on candidate submissions feeding the rubric grader.
# Fail-open + off by default: set ENABLE_PROMPT_SHIELD=true AND the endpoint/key to activate.
ENABLE_PROMPT_SHIELD=false
AZURE_CONTENT_SAFETY_ENDPOINT=https://your-contentsafety.cognitiveservices.azure.com/
AZURE_CONTENT_SAFETY_KEY=your_content_safety_key
AZURE_CONTENT_SAFETY_API_VERSION=2024-09-01
PROMPT_SHIELD_TIMEOUT_MS=4000

# ── Datadog LLM Observability (traces the scoring engine: latency, token cost, injection) ──
# Off unless DD_LLMOBS_ENABLED=1. Agentless mode ships spans straight to Datadog with only an
# API key (no Datadog Agent needed). Get the key from Datadog → Organization Settings → API Keys.
DD_LLMOBS_ENABLED=0
DD_API_KEY=
# DD_SITE MUST match your Datadog org's region or every span is silently 403'd.
# Find it in your Datadog URL (e.g. us5.datadoghq.com). This org is on US5.
DD_SITE=us5.datadoghq.com
DD_LLMOBS_ML_APP=touchstones-scoring
DD_LLMOBS_AGENTLESS_ENABLED=true
DD_LLMOBS_CAPTURE_IO=true

# July MVP buildout scaffold. OFF by default; set true only in local/dev preview
# to expose /api/mvp-skeleton contracts used by the frontend skeleton hub.
ENABLE_MVP_SKELETONS=false

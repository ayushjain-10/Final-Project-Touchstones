{
  "name": "touchstone-backend",
  "version": "1.0.0",
  "description": "Backend for Touchstones - verified real-work screening for engineering hiring",
  "main": "src/app.js",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "start": "node src/app.js",
    "start:render": "./start-render.sh",
    "dev": "NODE_ENV=development nodemon src/app.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --reporters=default --reporters=jest-junit",
    "mock:seed": "node scripts/mockData.js",
    "mock:clear": "node scripts/mockData.js --clear",
    "smoke": "node scripts/smoke-e2e.mjs",
    "metrics:snapshot": "node scripts/metrics-snapshot.js",
    "e2e:selfserve": "node scripts/e2e-selfserve.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.105.0",
    "@azure/ai-form-recognizer": "^4.0.0",
    "@azure/ai-text-analytics": "^5.1.0",
    "@azure/openai": "^1.0.0-beta.7",
    "@confluentinc/kafka-javascript": "1.10.0",
    "@sentry/node": "^10.62.0",
    "@supabase/supabase-js": "2.89.0",
    "@temporalio/client": "^1.20.2",
    "axios": "^1.9.0",
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.0.0-rc.12",
    "cors": "^2.8.5",
    "dd-trace": "^5.110.0",
    "dotenv": "^16.5.0",
    "e2b": "^2.30.6",
    "express": "^4.18.2",
    "express-fileupload": "^1.5.1",
    "express-rate-limit": "^8.2.1",
    "express-session": "^1.18.1",
    "express-validator": "^7.0.1",
    "google-auth-library": "^9.15.1",
    "googleapis": "^169.0.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "natural": "^8.0.1",
    "nodemailer": "^7.0.12",
    "openai": "^4.97.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pdf-parse": "^1.1.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "stripe": "^20.1.0",
    "web-streams-polyfill": "^4.1.0",
    "ws": "^8.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/supertest": "^6.0.3",
    "jest": "^30.2.0",
    "jest-junit": "^16.0.0",
    "nodemon": "^3.0.1",
    "supertest": "^7.1.4"
  }
}
